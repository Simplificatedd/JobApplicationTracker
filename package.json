{
  "name": "job-application-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler pages dev",
    "dev:ui": "vite",
    "build": "tsc -b && vite build",
    "build:functions": "wrangler pages functions build functions --outdir .wrangler/functions-build --project-directory . --build-output-directory dist --compatibility-date 2026-09-22",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run build:functions",
    "lint": "eslint src functions vite.config.ts tailwind.config.ts scripts/*.mjs --max-warnings=0",
    "preview": "vite preview",
    "test": "vitest run && npm run test:production-release",
    "test:production-release": "node --experimental-strip-types --test scripts/*release*.test.mjs",
    "test:admission-local": "node --experimental-strip-types scripts/test-request-admission.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "engines": {
    "node": "^22.23.4"
  },
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.4.0",
    "miniflare": "5.20260921.0-alpha",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.44.1",
    "vite": "^8.3.0",
    "vitest": "4.1.11",
    "wrangler": "^4.136.2"
  }
}
