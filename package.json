{
  "name": "job-application-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "lint": "eslint . --max-warnings=0",
